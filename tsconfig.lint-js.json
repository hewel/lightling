{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"noImplicitAny": false,
		"noImplicitReturns": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"skipLibCheck": true,
		"strict": false
	},
	"include": [
		"*.js",
		"*.jsx",
		"*.mjs",
		"*.cjs",
		"scripts/**/*.js",
		"scripts/**/*.jsx",
		"scripts/**/*.mjs",
		"scripts/**/*.cjs",
		"packages/**/*.js",
		"packages/**/*.jsx",
		"packages/**/*.mjs",
		"packages/**/*.cjs"
	],
	"exclude": ["node_modules", "build", "dist", "thirdparty"]
}
