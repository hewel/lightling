{
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "name": "__MSG_ext_name__",
  "version": "7.1.0",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "icons": {
    "512": "static/logo.png"
  },
  "chromium:permissions": ["storage", "tabs", "contextMenus", "scripting", "offscreen"],
  "firefox:permissions": ["storage", "tabs", "contextMenus", "scripting", "<all_urls>"],
  "chromium:host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["contentscript.tsx"]
    }
  ],
  "chromium:web_accessible_resources": [
    {
      "resources": [
        "content-page-translator.js",
        "content-page-translator.css",
        "content-selected-translator.js",
        "content-selected-translator.css"
      ],
      "matches": ["*://*/*"]
    }
  ],
  "firefox:web_accessible_resources": [
    "content-page-translator.js",
    "content-page-translator.css",
    "content-selected-translator.js",
    "content-selected-translator.css"
  ],
  "options_ui": {
    "page": "pages/options/options.html",
    "open_in_tab": true
  },
  "chromium:content_security_policy": {
    "extension_pages": "default-src 'self' 'wasm-unsafe-eval'; connect-src *; style-src 'self' 'unsafe-inline' *"
  },
  "firefox:content_security_policy": "script-src 'self' 'unsafe-eval';",
  "chromium:sandbox": {
    "pages": ["../pages/offscreen-documents/translator/translator.html"]
  },
  "chromium:background": {
    "service_worker": "background-script.ts",
    "type": "module"
  },
  "firefox:background": {
    "scripts": ["background-script.firefox.ts"]
  },
  "chromium:action": {
    "default_popup": "pages/popup/popup.html",
    "default_title": "__MSG_ext_name__",
    "default_icon": "static/logo.png"
  },
  "firefox:browser_action": {
    "default_popup": "pages/popup/popup.html",
    "default_title": "__MSG_ext_name__",
    "default_icon": "static/logo.png"
  }
}
