{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "endOfLine": "lf",
  "printWidth": 90,
  "semi": true,
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": true,
    "sortSideEffects": true,
    "customGroups": [
      {
        "groupName": "side-effect-styles",
        "selector": "side_effect_style"
      },
      {
        "groupName": "side-effects",
        "selector": "side_effect"
      },
      {
        "groupName": "node-builtin",
        "elementNamePattern": ["node:*", "node:*/**"]
      },
      {
        "groupName": "scoped-external",
        "selector": "external",
        "elementNamePattern": ["@*/**"]
      },
      {
        "groupName": "deep-parent",
        "selector": "parent",
        "elementNamePattern": ["../../**"]
      }
    ],
    "groups": [
      "side-effects",
      "node-builtin",
      ["builtin", "external"],
      { "newlinesBetween": false },
      "scoped-external",
      ["internal", "subpath"],
      "deep-parent",
      ["parent", "sibling", "index"],
      ["style", "side-effect-styles"],
      "unknown"
    ]
  },
  "overrides": [
    {
      "files": ["src/components/providers/AstryxProvider.tsx"],
      "options": {
        "sortImports": false
      }
    },
    {
      "files": ["*.{md,yml}"],
      "options": {
        "tabWidth": 2
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "**/build",
    "dist",
    "public",
    "**/.docusaurus",
    "modules",
    "test",
    "thirdparty",
    "src/themes/astryx-*.css",
    "src/themes/vivid/**",
    "src/themes/stylex.css",
    "*.d.ts",
    "*.html",
    "*.md",
    "package-lock.json"
  ]
}
