{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "useGitignore": true,
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"],
  "ignorePaths": [
    "**/*.test.ts",
    "node_modules",
    "**/build",
    "dist",
    "public",
    "**/.docusaurus",
    "modules",
    "test",
    "thirdparty",
    "**/*.d.ts",
    "**/*.html",
    "**/*.md",
    "package-lock.json"
  ]
}
